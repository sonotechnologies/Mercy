# Supabase (leave empty to run the demo on browser storage)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Publishable key (called "anon" key in older projects). Safe to expose.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (called "service_role" in older projects). Server only — never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Optional: final domain for link previews and the sitemap
NEXT_PUBLIC_SITE_URL=
