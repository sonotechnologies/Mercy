# Supabase (leave empty to run the demo on browser storage).
# Only the public URL and publishable key are needed; orders go through database functions.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional: final domain for link previews and the sitemap
NEXT_PUBLIC_SITE_URL=
